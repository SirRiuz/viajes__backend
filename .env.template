# One .env per machine, read the same by the dev stack (`make up`) and the
# production one (`make prod-up`).

# Database credentials
# Local: the `postgres` compose service (no SSL), started by the local-db
# profile below. Managed PostgreSQL (Neon…): its host/user/password,
# DATABASE_SSLMODE = "require" and remove COMPOSE_PROFILES. SQLite: engine
# "django.db.backends.sqlite3", DATABASE_NAME = the file name.
COMPOSE_PROFILES = "local-db"
DATABASE_ENGINE = "django.db.backends.postgresql"
DATABASE_HOST = "postgres"
DATABASE_NAME = "postgres"
DATABASE_USER ="postgres"
DATABASE_PASSWORD = "postgres"
DATABASE_PORT = "5432"
DATABASE_SSLMODE = "disable"

# Settings project
DEBUG = True
APP_NAME = "viajes"
SERVER_PORT = 8080
# Min 50 chars (signs the session JWTs). `make` generates both in a new .env:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY = "..."
API_SECRET_KEY = "..."
# The hosts this machine answers for. Production refuses «*». On the server:
# its domain, e.g. "backend.transhidrosogamoso.com".
# Comments always on their own line: decouple keeps inline ones in the value.
ALLOWED_HOSTS = "localhost,127.0.0.1"
CSRF_TRUSTED_ORIGINS = "http://localhost:8080,http://0.0.0.0:8080"
CORS_ALLOWED_ORIGINS = "http://localhost:8080,http://0.0.0.0:8080,http://localhost:5173"
INTERNAL_ADMIN_URL = "staff/tools/"
INTERNAL_GRAPHQL_URL = "graphql/"

# Reverse proxies that append to X-Forwarded-For before Django (nginx = 1).
# Cloudflare's address is already replaced by the visitor's in nginx.
TRUSTED_PROXY_COUNT = 1

# Origin hidden behind Cloudflare (nginx/nginx.conf.template). 1: anything
# not coming from Cloudflare or this machine gets no answer at all, so
# scanners (Shodan, FOFA) can't tie the server's IP to the site. 0 only for
# an origin without Cloudflare in front.
ORIGIN_ONLY_CLOUDFLARE = 1
# Cloudflare Tunnel (recommended on the server): add "tunnel" to
# COMPOSE_PROFILES (e.g. "tunnel" or "local-db,tunnel"), paste the tunnel's
# token and listen only on 127.0.0.1: the server then needs no open port.
TUNNEL_TOKEN = ""
NGINX_BIND = "0.0.0.0"

# Shared cache (Valkey). Empty = per-process memory.
CACHE_URL = "redis://valkey:6379/0"

# User the containers run as: the owner of this folder (`id -u` / `id -g`),
# so they can write the generated migrations and, with SQLite, the database.
APP_UID = 1000
APP_GID = 1000

# Production server (Granian, ci/docker-compose.yml): processes and threads
# per process. 2 × 4 suits 1–2 vCPU. The production stack forces DEBUG off,
# whatever DEBUG says here.
GRANIAN_WORKERS = 2
GRANIAN_BLOCKING_THREADS = 4

# Media settings (driver documents)
# Local: files on disk (media/). Production: True and the bucket values.
USE_AWS_STORAGE_SYSTEM = False
AWS_ACCESS_KEY_ID = "..."
AWS_SECRET_ACCESS_KEY = "..."
AWS_STORAGE_BUCKET_NAME = "..."
AWS_S3_ENDPOINT_URL = "..."
AWS_S3_CUSTOM_DOMAIN = "..."
